# ============================================================
# Secrets — never commit
# ============================================================
.env
.env.*
# keep the committed template (negation must come AFTER .env.*)
!.env.example
*.token
.supabase_token*
*.pem
*.key
*.p12
*.keystore
service-account*.json

# Vercel
.vercel/
.vercel

# Flutter / Dart build artifacts
**/build/
**/.dart_tool/
**/.pub-cache/
**/.flutter-plugins-dependencies
**/.flutter-plugins
**/pubspec.lock.bak

# JS / Node build output
node_modules/
dist/
.next/

# IDE / editor
.idea/
*.iml
.vscode/
.history/
.DS_Store

# Logs
*.log

# Python
*.pyc
__pycache__/

# Supabase local artifacts
backend/supabase/.branches/
backend/supabase/.temp/
# root-level Supabase CLI cache (machine-specific) — note the leading slash
# so this does NOT match the tracked backend/supabase/ directory
/supabase/

# Local analysis dump (DB-derived; not project source) — per migration decision
/sma_stems.json

# Gemini image MCP — local artifacts.
# The API key is supplied ONLY via the ${GEMINI_API_KEY} environment variable
# (see .mcp.json) and must never be written to a tracked file. These patterns
# catch the server's optional local config and default image output dir.
.gemini-image-mcp.json
/gemini-images/

# Manim render artifacts (videos are build artifacts, never committed)
# NB : le motif nu `media/` a été retiré (2026-08-14). Il attrapait TOUS
# les dossiers `media/` du dépôt, y compris `content/<notion>/media/` où
# vivent les figures de leçon. Les figures déjà suivies n'en souffraient
# pas (gitignore n'affecte pas un fichier suivi), donc le piège était
# invisible : toute figure NOUVELLE était silencieusement non commitée.
# `animations/media*/` couvre déjà l'intention d'origine.
animations/media*/
temp_audit/
animations/audit/

# Captures d'audit (web/shots) — ce sont des ARTEFACTS de session, pas des
# sources : régénérables par `node scripts/shots.mjs`, 8 Mo de PNG qui
# n'apportent rien à un clone. Détrackées le 2026-08-15.
web/shots/

# Sorties de l'audit visuel des figures (web/scripts/figure-preview.mjs) :
# des PNG régénérables en une commande, jamais du contenu.
.figure-preview/
