{
  "mcpServers": {
    "gemini-image": {
      "command": "npx",
      "args": ["-y", "@jimothy-snicket/gemini-image-mcp"],
      "env": {
        "GEMINI_API_KEY": "${GEMINI_API_KEY}",
        "MAX_REQUESTS_PER_HOUR": "15",
        "MAX_COST_PER_HOUR": "3",
        "GEMINI_IMAGE_AUTO_INSTALL": "0"
      }
    },
    "notebooklm": {
      "command": "npx",
      "args": ["-y", "notebooklm-mcp@2.0.0"],
      "env": {
        "HEADLESS": "true"
      }
    }
  }
}
