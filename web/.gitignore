# Day-3 option-set images are COMMITTED evidence (owner decision aid) —
# exception to the shots/ ignore above.
!/shots/
/shots/*
!/shots/options/

# Day-6 report evidence (curated before/afters for phone review) — same
# committed-evidence exception; the full day6 matrix stays local.
!/shots/day6/
/shots/day6/*
!/shots/day6/report/

# Day-7 owner blind-test pairs (unlabeled; key sealed in the ledger) —
# committed evidence; the full day7 matrix stays local.
!/shots/day7/
/shots/day7/*
!/shots/day7/blind/

# July-2026 external-audit evidence (curated before/afters) — committed;
# the full day8-audit measurement set stays local.
!/shots/day8-audit/
/shots/day8-audit/*
!/shots/day8-audit/report/

# Day-8 wide-viewport option sets + before evidence — committed for the
# owner's same-day picks; the full day8-wide matrix stays local.
!/shots/day8-wide/
/shots/day8-wide/*
!/shots/day8-wide/report/

# Day-9 site-skeleton evidence (dashboard / matière / onboarding) — committed
